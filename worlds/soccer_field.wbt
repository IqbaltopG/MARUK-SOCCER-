EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/balls/protos/SoccerBall.proto"

WorldInfo {
  info [
    "MIT-WEEK 2026 Robot Car Soccer Arena"
    "Field: 244 cm x 122 cm"
    "Goals: 38 cm x 20 cm"
    "Ball: 4 cm Pingpong Ball"
    "Robot: MARUK 2WD + Caster + Flat Board (< 18x18 cm)"
  ]
  title "MIT-WEEK 2026 Robot Soccer"
  basicTimeStep 16
}
Viewpoint {
  orientation 0.28 -0.45 -0.85 5.1
  position -1.8 -2.4 2.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}

# ==========================================
# ARENA RESMI MIT-WEEK 2026 (244 cm x 122 cm)
# ==========================================
DEF SOCCER_FIELD Solid {
  children [
    # Lapangan Karpet Hijau (2.44m x 1.22m)
    DEF GROUND Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.45 0.15
        roughness 0.8
        metalness 0.1
      }
      geometry Plane {
        size 2.44 1.22
      }
    }
    # Garis Tengah Putih
    Pose {
      translation 0 0 0.001
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.6
          }
          geometry Box {
            size 0.02 1.22 0.001
          }
        }
      ]
    }
    # Lingkaran Tengah Putih
    Pose {
      translation 0 0 0.001
      rotation 1 0 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.6
          }
          geometry Cylinder {
            height 0.001
            radius 0.20
          }
        }
      ]
    }
    # Dinding Utara (North Wall)
    Pose {
      translation 0 0.62 0.10
      children [
        DEF WALL_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
            metalness 0.1
          }
          geometry Box {
            size 2.48 0.02 0.20
          }
        }
      ]
    }
    # Dinding Selatan (South Wall)
    Pose {
      translation 0 -0.62 0.10
      children [
        USE WALL_SHAPE
      ]
    }
    # Dinding Barat Sisi Atas (West Upper)
    Pose {
      translation -1.23 0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Barat Sisi Bawah (West Lower)
    Pose {
      translation -1.23 -0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Timur Sisi Atas (East Upper)
    Pose {
      translation 1.23 0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Timur Sisi Bawah (East Lower)
    Pose {
      translation 1.23 -0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Gawang Kuning (Barat: Lebar 38cm, Tinggi 20cm, Dalam 15cm)
    Pose {
      translation -1.31 0 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.7 0.1
            roughness 0.3
          }
          geometry Box {
            size 0.16 0.38 0.20
          }
        }
      ]
    }
    # Gawang Biru (Timur: Lebar 38cm, Tinggi 20cm, Dalam 15cm)
    Pose {
      translation 1.31 0 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.4 0.9
            roughness 0.3
          }
          geometry Box {
            size 0.16 0.38 0.20
          }
        }
      ]
    }
  ]
  boundingObject Group {
    children [
      # Lantai
      Plane { size 2.44 1.22 }
      # Dinding Utara & Selatan
      Pose { translation 0 0.62 0.10 children [ Box { size 2.48 0.02 0.20 } ] }
      Pose { translation 0 -0.62 0.10 children [ Box { size 2.48 0.02 0.20 } ] }
      # Dinding Barat
      Pose { translation -1.23 0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation -1.23 -0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation -1.39 0 0.10 children [ Box { size 0.02 0.40 0.20 } ] }
      # Dinding Timur
      Pose { translation 1.23 0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation 1.23 -0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation 1.39 0 0.10 children [ Box { size 0.02 0.40 0.20 } ] }
    ]
  }
  locked TRUE
}

# ==========================================
# BOLA PINGPONG RESMI (Diameter 4cm, Massa 3g)
# ==========================================
DEF BALL SoccerBall {
  translation 0.0 0.0 0.02
  rotation 0 0 1 0
  radius 0.02
  mass 0.003
}

# ==========================================
# ROBOT MARUK 2WD + KASTOR + PAPAN LURUS
# Dimensi: 16cm x 16cm x 7cm (Lolos regulasi < 18x18cm)
# ==========================================
DEF MARUK_BOT Robot {
  translation -0.45 0.0 0.033
  rotation 0 0 1 0
  children [
    # Sasis Utama (Chassis Box: 14cm panjang x 12cm lebar x 4cm tinggi)
    DEF BODY_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.18 0.22
        roughness 0.4
        metalness 0.6
      }
      geometry Box {
        size 0.14 0.12 0.04
      }
    }
    # BUMPER DEPAN LURUS RESMI (STRICT FLAT BOARD)
    # Panjang 16cm, Tinggi 5cm, Tebal 6mm - RATA TANPA LEKUKAN
    Pose {
      translation 0.073 0 0.005
      children [
        DEF FLAT_BUMPER Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.2 0.2
            roughness 0.2
            metalness 0.1
          }
          geometry Box {
            size 0.006 0.16 0.05
          }
        }
      ]
    }
    # Roda Kiri Belakang (Motor Kuning + Roda Karet Kuning Standard)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 0.068 -0.002
      }
      device [
        RotationalMotor {
          name "left_motor"
        }
      ]
      endPoint Solid {
        translation -0.035 0.068 -0.002
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.95 0.75 0.1
              roughness 0.6
              metalness 0.1
            }
            geometry Cylinder {
              height 0.026
              radius 0.0325
            }
          }
        ]
        name "left_wheel"
        boundingObject USE WHEEL_SHAPE
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.035
        }
      }
    }
    # Roda Kanan Belakang (Motor Kuning + Roda Karet Kuning Standard)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 -0.068 -0.002
      }
      device [
        RotationalMotor {
          name "right_motor"
        }
      ]
      endPoint Solid {
        translation -0.035 -0.068 -0.002
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "right_wheel"
        boundingObject USE WHEEL_SHAPE
        physics USE WHEEL_PHYSICS
      }
    }
    # Roda Kastor 1 (Kastor Depan Kiri - Penyeimbang Pasif)
    Pose {
      translation 0.055 0.045 -0.02
      children [
        DEF CASTER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.85
            roughness 0.1
            metalness 0.9
          }
          geometry Sphere {
            radius 0.0125
          }
        }
      ]
    }
    # Roda Kastor 2 (Kastor Depan Kanan - Penyeimbang Pasif)
    Pose {
      translation 0.055 -0.045 -0.02
      children [
        USE CASTER_SHAPE
      ]
    }
  ]
  name "MARUK_SOCCER_BOT"
  boundingObject Group {
    children [
      # Bodi sasis
      USE BODY_SHAPE
      # Bumper lurus depan
      Pose { translation 0.073 0 0.005 children [ Box { size 0.006 0.16 0.05 } ] }
      # Kastor 1 & 2
      Pose { translation 0.055 0.045 -0.02 children [ Sphere { radius 0.0125 } ] }
      Pose { translation 0.055 -0.045 -0.02 children [ Sphere { radius 0.0125 } ] }
    ]
  }
  physics Physics {
    density -1
    mass 0.45
  }
  controller "maruk_soccer"
}
