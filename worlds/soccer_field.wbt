WorldInfo {
  info [
    "A soccer game."
    "This example demonstrates several capabilities of the supervisor:"
    "- read and modify the position of objects"
    "- display text on the simulation window"
    "- send messages to robot controllers"
  ]
  title "Soccer Game"
  optimalThreadCount 8
}
