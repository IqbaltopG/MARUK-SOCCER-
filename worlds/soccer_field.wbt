DEF MARUK_BOT Robot {
  translation -0.35 0.0 0.038
  rotation 0 0 1 0
  children [
    DEF BODY_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.15 0.2
        roughness 0.3
        metalness 0.7
        emissiveColor 0 0.6 0.4
      }
      geometry Box {
        size 0.12 0.10 0.04
      }
    }
    # Front-Left Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.035 0.055 -0.012
      }
      device [
        RotationalMotor {
          name "fl_motor"
        }
      ]
      endPoint Solid {
        translation 0.035 0.055 -0.012
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.9 0.4 0.1
              roughness 0.5
              metalness 0.1
            }
            geometry Cylinder {
              height 0.015
              radius 0.022
            }
          }
        ]
        name "fl_wheel"
        boundingObject USE WHEEL_SHAPE
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.015
        }
      }
    }
    # Front-Right Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.035 -0.055 -0.012
      }
      device [
        RotationalMotor {
          name "fr_motor"
        }
      ]
      endPoint Solid {
        translation 0.035 -0.055 -0.012
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "fr_wheel"
        boundingObject USE WHEEL_SHAPE
        physics USE WHEEL_PHYSICS
      }
    }
    # Rear-Left Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 0.055 -0.012
      }
      device [
        RotationalMotor {
          name "rl_motor"
        }
      ]
      endPoint Solid {
        translation -0.035 0.055 -0.012
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "rl_wheel"
        boundingObject USE WHEEL_SHAPE
        physics USE WHEEL_PHYSICS
      }
    }
    # Rear-Right Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 -0.055 -0.012
      }
      device [
        RotationalMotor {
          name "rr_motor"
        }
      ]
      endPoint Solid {
        translation -0.035 -0.055 -0.012
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "rr_wheel"
        boundingObject USE WHEEL_SHAPE
        physics USE WHEEL_PHYSICS
      }
    }
    # Front Dribbler Roller
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0.065 0.0 -0.005
      }
      device [
        RotationalMotor {
          name "dribbler_motor"
        }
      ]
      endPoint Solid {
        translation 0.065 0.0 -0.005
        rotation 1 0 0 1.5708
        children [
          DEF DRIBBLER_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.2 0.8 0.3
              roughness 0.9
              metalness 0
            }
            geometry Cylinder {
              height 0.06
              radius 0.01
            }
          }
        ]
        name "dribbler_roller"
        boundingObject USE DRIBBLER_SHAPE
        physics Physics {
          density -1
          mass 0.01
        }
      }
    }
  ]
  name "MARUK_SOCCER_BOT"
  boundingObject USE BODY_SHAPE
  physics Physics {
    density -1
    mass 0.45
  }
  controller "maruk_soccer"
}

