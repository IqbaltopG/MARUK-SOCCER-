#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

WorldInfo {
  info [
    "MIT-WEEK 2026 Robot Car Soccer Arena"
    "Field: 244 cm x 122 cm"
    "Goals: 38 cm x 20 cm"
    "Ball: 4 cm Pingpong Ball"
    "Robot: MARUK 2WD + Caster Wheels + Elevated Front Plate"
  ]
  title "MIT-WEEK 2026 Robot Soccer"
  basicTimeStep 16
  contactProperties [
    # Roda karet belakang: Grip maksimal ke karpet
    ContactProperties {
      material1 "wheel"
      material2 "ground"
      coulombFriction [ 3.0 ]
      bounce 0
    }
    # Roda kastor depan: Licin tanpa gesekan (Teflon 0.0)
    ContactProperties {
      material1 "caster"
      material2 "ground"
      coulombFriction [ 0.0 ]
      bounce 0
    }
    # Benturan plat bumper depan ke bola pingpong
    ContactProperties {
      material1 "bumper"
      material2 "ball"
      coulombFriction [ 0.9 ]
      bounce 0.3
      bounceVelocity 0.05
    }
    # Bola pingpong ke karpet
    ContactProperties {
      material1 "ball"
      material2 "ground"
      coulombFriction [ 0.6 ]
      bounce 0.35
      bounceVelocity 0.05
    }
  ]
}
Viewpoint {
  orientation 0.28 -0.45 -0.85 5.1
  position -1.8 -2.4 2.2
}
TexturedBackground {
}
TexturedBackgroundLight {
}

# ==========================================
# ARENA RESMI MIT-WEEK 2026 (244 cm x 122 cm)
# ==========================================
DEF SOCCER_FIELD Solid {
  children [
    DEF GROUND Shape {
      appearance PBRAppearance {
        baseColor 0.08 0.45 0.15
        roughness 0.8
        metalness 0.1
      }
      geometry Plane {
        size 2.44 1.22
      }
    }
    # Garis Tengah Putih
    Pose {
      translation 0 0 0.001
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.6
          }
          geometry Box {
            size 0.02 1.22 0.001
          }
        }
      ]
    }
    # Lingkaran Tengah Putih
    Pose {
      translation 0 0 0.001
      rotation 1 0 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.95 0.95 0.95
            roughness 0.6
          }
          geometry Cylinder {
            height 0.001
            radius 0.20
          }
        }
      ]
    }
    # Dinding Utara (North Wall)
    Pose {
      translation 0 0.62 0.10
      children [
        DEF WALL_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
            metalness 0.1
          }
          geometry Box {
            size 2.48 0.02 0.20
          }
        }
      ]
    }
    # Dinding Selatan (South Wall)
    Pose {
      translation 0 -0.62 0.10
      children [
        USE WALL_SHAPE
      ]
    }
    # Dinding Barat Sisi Atas (West Upper)
    Pose {
      translation -1.23 0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Barat Sisi Bawah (West Lower)
    Pose {
      translation -1.23 -0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Timur Sisi Atas (East Upper)
    Pose {
      translation 1.23 0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Dinding Timur Sisi Bawah (East Lower)
    Pose {
      translation 1.23 -0.405 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.82 0.82 0.78
            roughness 0.5
          }
          geometry Box {
            size 0.02 0.41 0.20
          }
        }
      ]
    }
    # Gawang Kuning (Barat: Lebar 38cm, Tinggi 20cm)
    Pose {
      translation -1.31 0 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.7 0.1
            roughness 0.3
          }
          geometry Box {
            size 0.16 0.38 0.20
          }
        }
      ]
    }
    # Gawang Biru (Timur: Lebar 38cm, Tinggi 20cm)
    Pose {
      translation 1.31 0 0.10
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.4 0.9
            roughness 0.3
          }
          geometry Box {
            size 0.16 0.38 0.20
          }
        }
      ]
    }
  ]
  contactMaterial "ground"
  boundingObject Group {
    children [
      Plane { size 2.44 1.22 }
      Pose { translation 0 0.62 0.10 children [ Box { size 2.48 0.02 0.20 } ] }
      Pose { translation 0 -0.62 0.10 children [ Box { size 2.48 0.02 0.20 } ] }
      Pose { translation -1.23 0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation -1.23 -0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation -1.39 0 0.10 children [ Box { size 0.02 0.40 0.20 } ] }
      Pose { translation 1.23 0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation 1.23 -0.405 0.10 children [ Box { size 0.02 0.41 0.20 } ] }
      Pose { translation 1.39 0 0.10 children [ Box { size 0.02 0.40 0.20 } ] }
    ]
  }
  locked TRUE
}

# ==========================================
# BOLA PINGPONG RESMI (Diameter 4cm, Massa 8g, Damping)
# ==========================================
DEF BALL Solid {
  translation 0.0 0.0 0.02
  children [
    DEF PINGPONG_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 1 0.72 0.08
        roughness 0.3
        metalness 0
      }
      geometry Sphere {
        radius 0.02
        subdivision 3
      }
    }
  ]
  name "pingpong ball"
  contactMaterial "ball"
  boundingObject USE PINGPONG_SHAPE
  physics Physics {
    density -1
    mass 0.008
    damping Damping {
      linear 0.25
      angular 0.25
    }
  }
}

# ==========================================
# ROBOT MARUK 2WD + KASTOR WHEEL + PLAT DEPAN DITINGGIKAN
# Plat Depan: Ground Clearance 12 mm di atas lantai (Anti-Ngesrok Total!)
# Dimensi: 16cm x 16cm x 7cm (< 18x18cm)
# ==========================================
DEF MARUK_BOT Robot {
  translation -0.45 0.0 0.0325
  rotation 0 0 1 0
  children [
    # 1. Bodi Sasis Utama
    DEF BODY_SHAPE Shape {
      appearance PBRAppearance {
        baseColor 0.15 0.18 0.22
        roughness 0.4
        metalness 0.6
      }
      geometry Box {
        size 0.14 0.12 0.035
      }
    }
    # 2. PLAT DEPAN LURUS DITINGGIKAN (ELEVATED FLAT BOARD)
    # Ground Clearance: 12 mm di atas lantai (TIDAK AKAN PERNAH KENGESEK LANTAI)
    # Dimensi: Panjang 16cm, Tinggi 3.8cm, Tebal 6mm
    Pose {
      translation 0.073 0 -0.0015
      children [
        DEF FLAT_BUMPER Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.2 0.2
            roughness 0.25
            metalness 0.1
          }
          geometry Box {
            size 0.006 0.16 0.038
          }
        }
      ]
    }
    # 3. Roda Kastor Kiri Depan (Teflon Caster Wheel)
    Pose {
      translation 0.055 0.048 -0.020
      children [
        DEF CASTER_SHAPE Shape {
          appearance PBRAppearance {
            baseColor 0.8 0.8 0.85
            roughness 0.05
            metalness 0.9
          }
          geometry Sphere {
            radius 0.0125
          }
        }
      ]
    }
    # 4. Roda Kastor Kanan Depan (Teflon Caster Wheel)
    Pose {
      translation 0.055 -0.048 -0.020
      children [
        USE CASTER_SHAPE
      ]
    }
    # 5. Roda Kiri Belakang (Motor Kuning)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 0.068 0.0
      }
      device [
        RotationalMotor {
          name "left_motor"
          maxVelocity 50
          maxTorque 3.5
          acceleration 80
        }
      ]
      endPoint Solid {
        translation -0.035 0.068 0.0
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance {
              baseColor 0.95 0.75 0.1
              roughness 0.6
              metalness 0.1
            }
            geometry Cylinder {
              height 0.026
              radius 0.0325
            }
          }
        ]
        name "left_wheel"
        contactMaterial "wheel"
        boundingObject USE WHEEL_SHAPE
        physics DEF WHEEL_PHYSICS Physics {
          density -1
          mass 0.035
        }
      }
    }
    # 6. Roda Kanan Belakang (Motor Kuning)
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor -0.035 -0.068 0.0
      }
      device [
        RotationalMotor {
          name "right_motor"
          maxVelocity 50
          maxTorque 3.5
          acceleration 80
        }
      ]
      endPoint Solid {
        translation -0.035 -0.068 0.0
        rotation 1 0 0 1.5708
        children [
          USE WHEEL_SHAPE
        ]
        name "right_wheel"
        contactMaterial "wheel"
        boundingObject USE WHEEL_SHAPE
        physics USE WHEEL_PHYSICS
      }
    }
  ]
  contactMaterial "caster"
  boundingObject Group {
    children [
      USE BODY_SHAPE
      Pose { translation 0.073 0 -0.0015 children [ Box { size 0.006 0.16 0.038 } ] }
      Pose { translation 0.055 0.048 -0.020 children [ Sphere { radius 0.0125 } ] }
      Pose { translation 0.055 -0.048 -0.020 children [ Sphere { radius 0.0125 } ] }
    ]
  }
  physics Physics {
    density -1
    mass 0.55
    centerOfMass [ 0.01 0 -0.012 ]
    damping Damping {
      linear 0.2
      angular 0.8
    }
  }
  controller "maruk_soccer"
}
